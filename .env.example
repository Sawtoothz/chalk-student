# Copy this file to .env (never commit .env), then rebuild: docker compose build

# AI agents to install in the image, for building your own packages (studying the included ones needs none).
# Any of: @anthropic-ai/claude-code  @openai/codex  @google/gemini-cli   (each adds 100-650 MB)
# CHALK_AI=@anthropic-ai/claude-code

# API keys, if you use a key instead of logging in to the AI tool:
# ANTHROPIC_API_KEY=sk-ant-...
# OPENAI_API_KEY=sk-...
# GEMINI_API_KEY=...
